# Node.js 24. A local file is used only for local/server installations.
TIBB_DATABASE_PATH=./data/tibb.sqlite
# Local/server upload files must also live on persistent disk.
TIBB_UPLOAD_DIR=./data/uploads
APP_URL=http://localhost:3000
# Public canonical origin. Keep the Vercel domain until tibb.nu is connected.
SITE_URL=https://tibbnu.vercel.app
# Optional public verification codes from Search Console / Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Required on Vercel. Connect a Turso database through Vercel Marketplace.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Storage: connect a PRIVATE Blob store to create these variables.
# Vercel provides OIDC automatically; do not copy its temporary token here.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Optional Blob credential outside Vercel (also needs BLOB_WEBHOOK_PUBLIC_KEY).
BLOB_READ_WRITE_TOKEN=
# A long random token for the initial /setup page. Remove after creating your admin.
SETUP_TOKEN=
# Stripe for treatment bookings and one-time course purchases, managed as server secrets.
# Shared endpoint: /api/stripe/webhook. See docs/course-purchases-setup.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate endpoint for product orders: /api/shop/webhook. See docs/shop-setup.md.
SHOP_STRIPE_WEBHOOK_SECRET=
# Separate recurring memberships endpoint: /api/medlemskap/webhook.
MEMBERSHIP_STRIPE_WEBHOOK_SECRET=
# Restricted Stripe Billing portal configuration. See docs/memberships-setup.md.
MEMBERSHIP_STRIPE_PORTAL_CONFIGURATION_ID=
# Optional transactional email. Configure a verified Resend sender first.
# Never prefix these with NEXT_PUBLIC_. APP_URL above supplies trusted links.
RESEND_API_KEY=
EMAIL_FROM=
# Optional admin notification recipient; otherwise the configured contact email.
EMAIL_NOTIFICATION_TO=
# Optional protected outbox retry endpoint, /api/email/outbox (at least 32 chars).
CRON_SECRET=
# Only enable behind a proxy you operate that replaces x-forwarded-for.
# Vercel trusts its own IP header automatically; local development needs neither.
TRUST_PROXY=

# Anamnes V2: rule-based analysis works without AI or permanent health-data storage.
# Read docs/anamnes-v2-setup.md before enabling either server feature.
# Review flags record completed reviews; they do not provide legal certification.
ANAMNES_PRIVACY_REVIEWED=0
ANAMNES_CLINICAL_REVIEWED=0
ANAMNES_REGULATORY_REVIEWED=0
ANAMNES_AI_ENABLED=0
# Also select AI-assisted anamnes in Admin > Anamnes; the database default is rules.
# The admin choice never overrides missing credentials, review gates or consent.
# Shared fixed 24-hour provider-attempt cap, 1-1000; default 100.
# Exhaustion uses the local rule fallback. Failed provider attempts count too.
ANAMNES_AI_DAILY_LIMIT=100
# openai, or a separately reviewed Responses-compatible provider.
ANAMNES_AI_PROVIDER=openai
ANAMNES_AI_MODEL=
ANAMNES_AI_API_KEY=
# Only used with responses-compatible; an explicit public HTTPS Responses endpoint.
ANAMNES_AI_ENDPOINT=
# Real visitor information: recipient, purpose, retention, transfers and safeguards.
ANAMNES_AI_PRIVACY_NOTICE=
ANAMNES_SUBMISSIONS_ENABLED=0
ANAMNES_SUBMISSION_PRIVACY_NOTICE=
# Required for encrypted case storage: 32 random bytes encoded as 64 hex characters.
# Never prefix this or AI credentials with NEXT_PUBLIC_. Keep a protected backup.
ANAMNES_STORAGE_KEY=
# Comma-separated emails of existing admin accounts allowed to read health records.
# Empty by default. Admin role alone does not grant therapist access.
ANAMNES_THERAPIST_EMAILS=
# Active case access lasts 1-90 days; default 30. Includes reviews and contact data.
ANAMNES_RETENTION_DAYS=30
